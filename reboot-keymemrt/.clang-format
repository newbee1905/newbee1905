# Google C++ layout with tab indentation and snake_case naming throughout.
#
# Types take a _t suffix (option_parser_t), enumerators are plain snake case
# inside their scoped enum, functions, variables and file names are snake_case,
# and class members carry a trailing underscore.  Only foreign API names -
# OpenFHE, KeyMemRT - keep their original spelling.
BasedOnStyle: Google
Language: Cpp
Standard: c++17

UseTab: Always
TabWidth: 4
IndentWidth: 4
ContinuationIndentWidth: 4
ColumnLimit: 80

AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: WithoutElse
DerivePointerAlignment: false
PointerAlignment: Right
IncludeBlocks: Preserve
ReflowComments: false
