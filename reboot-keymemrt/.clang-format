# Google C++ style with tab indentation and snake_case naming.
#
# Types stay CamelCase as Google prescribes; functions, variables and file names
# are snake_case, and class members carry a trailing underscore.
BasedOnStyle: Google
Language: Cpp
Standard: c++17

UseTab: Always
TabWidth: 4
IndentWidth: 4
ContinuationIndentWidth: 4
ColumnLimit: 80

AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: WithoutElse
DerivePointerAlignment: false
PointerAlignment: Right
IncludeBlocks: Preserve
ReflowComments: false
